# Third-party source material is fetched locally; keep only metadata and tools.
research/case_studies/anthropic_zeta_2026/*.pdf
research/case_studies/anthropic_zeta_2026/*_extracted.txt

# Unrelated concurrent case-study workspace; never publish with RPCD artifacts.
research/case_studies/parisi_zamponi_jamming_2026/
