{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/rpcd/breadth-snapshot.schema.json",
  "title": "RPCD effective-breadth review snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "kind",
    "reviewer",
    "created_at",
    "entries",
    "similarities",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["planning_estimate", "post_rollout_review"]},
    "reviewer": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["route_id", "weight"],
        "properties": {
          "route_id": {"type": "string", "minLength": 1},
          "weight": {"type": "number", "minimum": 0}
        }
      }
    },
    "similarities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["route_a", "route_b", "value", "rationale"],
        "properties": {
          "route_a": {"type": "string", "minLength": 1},
          "route_b": {"type": "string", "minLength": 1},
          "value": {"type": "number", "minimum": 0, "maximum": 1},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
